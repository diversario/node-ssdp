{
  "name": "node-ssdp",
  "description": "A node.js SSDP client and server library.",
  "keywords": [
    "ssdp",
    "multicast",
    "media",
    "device",
    "upnp",
    "chromecast",
    "iot"
  ],
  "version": "5.0.0",
  "author": "Ilya Shaisultanov <github@diversario.com>",
  "dependencies": {
    "async": "^3.2.6",
    "bluebird": "^3.7.2",
    "debug": "^4.4.3",
    "extend": "^3.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/diversario/node-ssdp.git"
  },
  "bugs": {
    "url": "https://github.com/diversario/node-ssdp/issues"
  },
  "main": "./index",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "sinon": "^22.1.0"
  },
  "scripts": {
    "test": "mocha --exit --recursive test/lib",
    "test:network": "mocha --exit --timeout 15000 test/network",
    "coverage": "c8 --reporter=text --reporter=lcov mocha --exit --recursive test/lib"
  },
  "homepage": "https://github.com/diversario/node-ssdp#readme",
  "directories": {
    "example": "example",
    "test": "test"
  },
